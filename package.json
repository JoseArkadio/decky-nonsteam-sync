{
  "name": "decky-nonsteam-sync",
  "version": "0.1.0",
  "description": "Decky Loader plugin: non-Steam games from a removable SD card get Steam library entries, artwork and metadata, and their saves travel with the card between SteamOS devices.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types checks/duration.check.ts && node --experimental-strip-types checks/richtext.check.ts",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseArkadio/decky-nonsteam-sync.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steamos",
    "non-steam",
    "saves",
    "sd-card",
    "ludusavi"
  ],
  "author": "JoseArkadio",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/JoseArkadio/decky-nonsteam-sync/issues"
  },
  "homepage": "https://github.com/JoseArkadio/decky-nonsteam-sync#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
